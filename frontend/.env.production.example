# Copia este archivo como ".env" (en la carpeta raíz, junto a docker-compose.yml) y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# ---- Dominio ----
# Pruebas en tu computadora:  DOMAIN=:80   (entras por http://localhost)
# Servidor real:              DOMAIN=sccvi.midominio.com   (HTTPS automático; el DNS debe apuntar al servidor)
DOMAIN=:80
# Dirección pública que va dentro de los códigos QR del carnet
PUBLIC_BASE_URL=http://localhost

# ---- Base de datos (usa solo letras y números en la contraseña) ----
POSTGRES_USER=sccvi
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=sccvi

# ---- Seguridad ----
# Genera la clave con:  openssl rand -hex 32
SECRET_KEY=
# Administrador inicial (solo se crea la primera vez, con la base vacía). Contraseña de 10+ caracteres.
ADMIN_EMAIL=admin@tucentro.gt
ADMIN_PASSWORD=
# Apaga Swagger (/docs) si no quieres exponerlo públicamente
ENABLE_DOCS=true

# ---- Correo ----
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Telegram y WhatsApp (opcionales; ver .env.example del backend) ----
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_DEFAULT_COUNTRY=502

# Revisión automática de alertas, cada N horas
ALERT_CHECK_HOURS=24

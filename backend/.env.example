# Copia este archivo como ".env" (en la carpeta backend) y ajusta los valores.
# Se lee automáticamente al iniciar el backend.

# Base de datos: si no se define, usa SQLite local (sccvi.db). Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://sccvi:sccvi@localhost:5432/sccvi
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_MINUTES=480

# ---- Correo para las alertas ----
# Opción A: envío real por SMTP (ejemplo con Gmail; usa una "contraseña de aplicación")
# MAIL_MODE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicacion
# SMTP_FROM=tu_correo@gmail.com

# Opción B: demostración sin enviar nada (imprime el correo en la terminal del backend)
# MAIL_MODE=console

# Revisión automática de todos los niños, cada N horas (0 = solo manual)
ALERT_CHECK_HOURS=24

# ---- Carnet digital con QR ----
# Dirección del frontend que irá dentro del código QR. Para escanearlo con un celular en la misma
# red usa la IP de tu computadora y arranca el frontend con:  npm run dev -- --host
PUBLIC_BASE_URL=http://localhost:5173
